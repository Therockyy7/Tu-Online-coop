{
  "name": "tu-online",
  "version": "0.1.0",
  "private": true,
  "description": "Tu Online — game web co-op Chùa + Quán Bar (3D low-poly, Three.js + Socket.io)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --tsconfig server/tsconfig.json server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client",
    "bots": "tsx --tsconfig server/tsconfig.json scripts/bots.ts",
    "share": "node scripts/share.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "esbuild": "0.28.2",
    "express": "5.3.0",
    "mongodb": "7.7.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "three": "0.186.1",
    "vite": "8.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
